@model VentaFormViewModel

<div class="row g-3">
    <div class="col-md-3">
        <label asp-for="Fecha" class="form-label"></label>
        <input asp-for="Fecha" class="form-control" type="date" />
    </div>
    <div class="col-md-9">
        <label asp-for="Comprador" class="form-label"></label>
        <input asp-for="Comprador" class="form-control" placeholder="Ej. Beneficio La Central" />
        <span asp-validation-for="Comprador" class="text-danger small"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="Cantidad" class="form-label"></label>
        <input asp-for="Cantidad" class="form-control" type="number" step="0.01" min="0" id="cant" />
        <span asp-validation-for="Cantidad" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="UnidadMedida" class="form-label"></label>
        <select asp-for="UnidadMedida" class="form-select">
            <option value="Fanega">Fanega</option>
            <option value="Cajuela">Cajuela</option>
            <option value="Quintal">Quintal</option>
            <option value="kg">kg</option>
        </select>
    </div>
    <div class="col-md-3">
        <label asp-for="PrecioUnitario" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text">₡</span>
            <input asp-for="PrecioUnitario" class="form-control" type="number" step="0.01" min="0" id="precio" />
        </div>
        <span asp-validation-for="PrecioUnitario" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <label class="form-label">Total</label>
        <div class="form-control bg-light fw-bold" id="totalOut">₡0,00</div>
    </div>

    <div class="col-md-6">
        <label asp-for="LoteId" class="form-label"></label>
        <select asp-for="LoteId" class="form-select">
            <option value="">Sin lote específico</option>
            @foreach (var (id, t) in Model.Lotes) { <option value="@id" selected="@(Model.LoteId == id)">@t</option> }
        </select>
    </div>
    <div class="col-md-6">
        <label asp-for="PeriodoProductivoId" class="form-label"></label>
        <select asp-for="PeriodoProductivoId" class="form-select">
            <option value="">Sin período</option>
            @foreach (var (id, t) in Model.Periodos) { <option value="@id" selected="@(Model.PeriodoProductivoId == id)">@t</option> }
        </select>
    </div>

    <div class="col-12">
        <label asp-for="Observaciones" class="form-label"></label>
        <input asp-for="Observaciones" class="form-control" />
    </div>
</div>

<script>
    (function () {
        var c = document.getElementById("cant"), p = document.getElementById("precio"), o = document.getElementById("totalOut");
        function calc() {
            var t = (parseFloat(c.value) || 0) * (parseFloat(p.value) || 0);
            o.textContent = "₡" + t.toLocaleString("es-CR", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }
        [c, p].forEach(function (el) { el && el.addEventListener("input", calc); });
        calc();
    })();
</script>
