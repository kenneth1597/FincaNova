@model MovimientoFormViewModel
@{ ViewData["Title"] = "Movimiento de inventario"; }

<h1 class="fn-page-title"><i class="bi bi-arrow-down-up"></i> Movimiento de inventario</h1>
<p class="text-muted">Insumo: <strong>@Model.InsumoNombre</strong> · existencia actual: <strong>@Model.StockActual.ToString("N2") @Model.UnidadMedida</strong></p>

<div class="fn-card" style="max-width:640px">
    <form asp-action="Movimiento" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
        <input type="hidden" asp-for="InsumoId" />
        <div class="row g-3">
            <div class="col-md-5">
                <label asp-for="Tipo" class="form-label"></label>
                <select asp-for="Tipo" class="form-select">
                    <option value="@((int)TipoMovimientoInventario.Entrada)">Entrada (sumar)</option>
                    <option value="@((int)TipoMovimientoInventario.Salida)">Salida (restar)</option>
                    <option value="@((int)TipoMovimientoInventario.Ajuste)">Ajuste (fijar existencia)</option>
                </select>
            </div>
            <div class="col-md-4">
                <label asp-for="Cantidad" class="form-label"></label>
                <input asp-for="Cantidad" class="form-control" type="number" step="0.0001" min="0" />
                <span asp-validation-for="Cantidad" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Fecha" class="form-label"></label>
                <input asp-for="Fecha" class="form-control" type="date" />
            </div>
            <div class="col-md-8">
                <label asp-for="Motivo" class="form-label"></label>
                <input asp-for="Motivo" class="form-control" placeholder="Ej. Compra factura #123, corrección de conteo" />
            </div>
            <div class="col-md-4">
                <label asp-for="Costo" class="form-label"></label>
                <div class="input-group"><span class="input-group-text">₡</span><input asp-for="Costo" class="form-control" type="number" step="0.01" min="0" /></div>
            </div>
        </div>
        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Registrar movimiento</button>
            <a asp-action="Detalle" asp-route-id="@Model.InsumoId" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
