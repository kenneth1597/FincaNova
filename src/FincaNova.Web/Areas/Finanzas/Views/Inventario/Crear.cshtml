@model InsumoFormViewModel
@{ ViewData["Title"] = "Nuevo insumo"; }

<h1 class="fn-page-title"><i class="bi bi-box-seam"></i> Nuevo insumo</h1>

<div class="fn-card" style="max-width:720px">
    <form asp-action="Crear" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
        <div class="row g-3">
            <div class="col-md-7">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger small"></span>
            </div>
            <div class="col-md-5">
                <label asp-for="Tipo" class="form-label"></label>
                <select asp-for="Tipo" class="form-select">
                    @foreach (var t in Enum.GetValues<TipoInsumo>())
                    {
                        <option value="@((int)t)" selected="@(Model.Tipo == t)">@Ui.TipoInsumoTexto(t)</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label asp-for="UnidadMedida" class="form-label"></label>
                <input asp-for="UnidadMedida" class="form-control" list="unidades" />
                <datalist id="unidades"><option value="kg"></option><option value="L"></option><option value="saco"></option><option value="unidad"></option></datalist>
            </div>
            <div class="col-md-4">
                <label asp-for="StockInicial" class="form-label"></label>
                <input asp-for="StockInicial" class="form-control" type="number" step="0.01" min="0" />
            </div>
            <div class="col-md-4">
                <label asp-for="StockMinimo" class="form-label"></label>
                <input asp-for="StockMinimo" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="StockMinimo" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="FechaVencimiento" class="form-label"></label>
                <input asp-for="FechaVencimiento" class="form-control" type="date" />
                <span asp-validation-for="FechaVencimiento" class="text-danger small"></span>
                <span class="form-text">Obligatoria para insumos fitosanitarios / químicos.</span>
            </div>
        </div>
        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Guardar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
