@model IReadOnlyList<InsumoListItemViewModel>
@{
    ViewData["Title"] = "Inventario de insumos";
    var puedeGestionar = User.IsInRole(Roles.Administrador) || User.IsInRole(Roles.Caficultor);
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="fn-page-title mb-0"><i class="bi bi-box-seam"></i> Inventario de insumos</h1>
    @if (puedeGestionar)
    {
        <a class="btn btn-primary" asp-action="Crear"><i class="bi bi-plus-lg"></i> Nuevo insumo</a>
    }
</div>

<div class="fn-card mb-3">
    <label class="form-label small text-muted">Buscar insumo</label>
    <input type="text" id="buscador" class="form-control" placeholder="Escriba para filtrar en tiempo real…" value="@ViewBag.Query" />
</div>

<div class="fn-card p-0">
    <div class="table-responsive">
        <table class="table fn-table align-middle mb-0" id="tablaInsumos">
            <thead>
                <tr><th>Insumo</th><th>Tipo</th><th class="text-end">Existencia</th><th class="text-end">Mínimo</th><th>Vencimiento</th><th></th></tr>
            </thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-muted py-4"><i class="bi bi-box d-block fs-3 mb-1"></i>No hay insumos registrados.</td></tr>
            }
            @foreach (var i in Model)
            {
                <tr class="@(i.BajoMinimo ? "table-danger" : "")" data-nombre="@i.Nombre.ToLower()">
                    <td class="fw-semibold">
                        <a asp-action="Detalle" asp-route-id="@i.Id" class="text-decoration-none">@i.Nombre</a>
                        @if (i.BajoMinimo)
                        {
                            <span class="badge bg-danger ms-1" title="Stock por debajo del mínimo crítico"><i class="bi bi-exclamation-triangle"></i> Stock bajo</span>
                        }
                        @if (i.Vencido)
                        {
                            <span class="badge bg-warning text-dark ms-1">Vencido</span>
                        }
                    </td>
                    <td>@Ui.TipoInsumoTexto(i.Tipo)</td>
                    <td class="text-end">@i.StockActual.ToString("N2") @i.UnidadMedida</td>
                    <td class="text-end">@i.StockMinimo.ToString("N2")</td>
                    <td>@(i.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "—")</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Detalle" asp-route-id="@i.Id"><i class="bi bi-eye"></i></a>
                        @if (puedeGestionar)
                        {
                            <a class="btn btn-sm btn-outline-primary" asp-action="Movimiento" asp-route-insumoId="@i.Id" title="Registrar movimiento"><i class="bi bi-arrow-down-up"></i></a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<script>
    (function () {
        var input = document.getElementById("buscador");
        var filas = document.querySelectorAll("#tablaInsumos tbody tr[data-nombre]");
        input && input.addEventListener("input", function () {
            var q = this.value.trim().toLowerCase();
            filas.forEach(function (f) {
                f.style.display = f.dataset.nombre.indexOf(q) >= 0 ? "" : "none";
            });
        });
    })();
</script>
