@model CostoPorCajuelaViewModel
@{ ViewData["Title"] = "Costo por cajuela"; }

<h1 class="fn-page-title"><i class="bi bi-calculator"></i> Costo real de producción por cajuela</h1>

<form method="get" class="fn-card mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-6 col-md-4">
            <label class="form-label small text-muted">Lote</label>
            <select name="loteId" class="form-select">
                <option value="">— Seleccione —</option>
                @foreach (var (id, t) in Model.Lotes) { <option value="@id" selected="@(Model.LoteId == id)">@t</option> }
            </select>
        </div>
        <div class="col-6 col-md-4">
            <label class="form-label small text-muted">Período</label>
            <select name="periodoId" class="form-select">
                <option value="">— Seleccione —</option>
                @foreach (var (id, t) in Model.Periodos) { <option value="@id" selected="@(Model.PeriodoId == id)">@t</option> }
            </select>
        </div>
        <div class="col-12 col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-calculator"></i> Calcular</button>
            @if (Model.Calculado)
            {
                <a class="btn btn-outline-primary" asp-action="CostoPorCajuela" asp-route-loteId="@Model.LoteId" asp-route-periodoId="@Model.PeriodoId" asp-route-formato="pdf"><i class="bi bi-file-earmark-pdf"></i></a>
                <a class="btn btn-outline-primary" asp-action="CostoPorCajuela" asp-route-loteId="@Model.LoteId" asp-route-periodoId="@Model.PeriodoId" asp-route-formato="excel"><i class="bi bi-file-earmark-excel"></i></a>
            }
        </div>
    </div>
</form>

@if (Model.Calculado)
{
    <div class="fn-card" style="max-width:560px">
        <h2 class="h6 text-muted text-uppercase">@Model.LoteNombre · @Model.PeriodoNombre</h2>
        <table class="table mb-0">
            <tbody>
                <tr><td>Mano de obra (labores)</td><td class="text-end">@Ui.Money(Model.CostoManoDeObra)</td></tr>
                <tr><td>Insumos</td><td class="text-end">@Ui.Money(Model.CostoInsumos)</td></tr>
                <tr><td>Otros gastos</td><td class="text-end">@Ui.Money(Model.OtrosGastos)</td></tr>
                <tr class="fw-semibold border-top"><td>Gasto total</td><td class="text-end">@Ui.Money(Model.GastoTotal)</td></tr>
                <tr><td>Cajuelas recolectadas</td><td class="text-end">@Model.Cajuelas.ToString("N2")</td></tr>
                <tr class="fw-bold border-top">
                    <td>Costo por cajuela</td>
                    <td class="text-end @(Model.ProduccionIniciada ? "text-primary" : "text-muted")">
                        @(Model.ProduccionIniciada ? Ui.Money(Model.CostoUnitario) : "Producción no iniciada")
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
}
