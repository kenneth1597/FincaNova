@model GastoFormViewModel

<div class="row g-3">
    <div class="col-md-3">
        <label asp-for="Fecha" class="form-label"></label>
        <input asp-for="Fecha" class="form-control" type="date" />
    </div>
    <div class="col-md-4">
        <label asp-for="Categoria" class="form-label"></label>
        <select asp-for="Categoria" class="form-select">
            @foreach (var c in Enum.GetValues<CategoriaGasto>())
            {
                <option value="@((int)c)" selected="@(Model.Categoria == c)">@Ui.CategoriaGastoTexto(c)</option>
            }
        </select>
    </div>
    <div class="col-md-5">
        <label asp-for="Monto" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text">₡</span>
            <input asp-for="Monto" class="form-control" type="number" step="0.01" min="0.01" />
        </div>
        <span asp-validation-for="Monto" class="text-danger small"></span>
    </div>

    <div class="col-md-8">
        <label asp-for="Descripcion" class="form-label"></label>
        <input asp-for="Descripcion" class="form-control" placeholder="Ej. Compra de fertilizante 18-5-15" />
        <span asp-validation-for="Descripcion" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Proveedor" class="form-label"></label>
        <input asp-for="Proveedor" class="form-control" />
    </div>

    <div class="col-md-6">
        <label asp-for="LoteId" class="form-label"></label>
        <select asp-for="LoteId" class="form-select">
            <option value="">Gasto general de finca</option>
            @foreach (var (id, t) in Model.Lotes) { <option value="@id" selected="@(Model.LoteId == id)">@t</option> }
        </select>
    </div>
    <div class="col-md-6">
        <label asp-for="PeriodoProductivoId" class="form-label"></label>
        <select asp-for="PeriodoProductivoId" class="form-select">
            <option value="">Sin período</option>
            @foreach (var (id, t) in Model.Periodos) { <option value="@id" selected="@(Model.PeriodoProductivoId == id)">@t</option> }
        </select>
    </div>

    <div class="col-12">
        <label asp-for="Comprobante" class="form-label"></label>
        <input asp-for="Comprobante" class="form-control" type="file" accept=".pdf,.jpg,.jpeg,.png" />
        <span asp-validation-for="Comprobante" class="text-danger small"></span>
        @if (!string.IsNullOrEmpty(Model.ComprobanteActual))
        {
            <span class="form-text">
                Ya hay un comprobante adjunto (<a asp-action="Comprobante" asp-route-id="@Model.Id" target="_blank">ver</a>).
                Suba uno nuevo solo si desea reemplazarlo.
            </span>
        }
    </div>
</div>
