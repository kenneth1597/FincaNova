@model RecoleccionFormViewModel

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="LoteId" class="form-label"></label>
        <select asp-for="LoteId" class="form-select">
            <option value="">— Seleccione el lote —</option>
            @foreach (var (id, t) in Model.Lotes) { <option value="@id" selected="@(Model.LoteId == id)">@t</option> }
        </select>
        <span asp-validation-for="LoteId" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="PeriodoProductivoId" class="form-label"></label>
        <select asp-for="PeriodoProductivoId" class="form-select">
            <option value="">— Seleccione el período —</option>
            @foreach (var (id, t) in Model.Periodos) { <option value="@id" selected="@(Model.PeriodoProductivoId == id)">@t</option> }
        </select>
        <span asp-validation-for="PeriodoProductivoId" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="ColaboradorId" class="form-label"></label>
        <select asp-for="ColaboradorId" class="form-select">
            <option value="">— Seleccione el trabajador —</option>
            @foreach (var (id, t) in Model.Colaboradores) { <option value="@id" selected="@(Model.ColaboradorId == id)">@t</option> }
        </select>
        <span asp-validation-for="ColaboradorId" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Fecha" class="form-label"></label>
        <input asp-for="Fecha" class="form-control" type="date" />
        <span asp-validation-for="Fecha" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Cajuelas" class="form-label"></label>
        <input asp-for="Cajuelas" class="form-control" type="number" step="0.25" min="0" id="cajuelas" />
        <span asp-validation-for="Cajuelas" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <div class="alert alert-success py-2 mb-0">
            <i class="bi bi-calculator"></i>
            Peso estimado: <strong id="pesoPreview">0,00 kg</strong>
            <span class="text-muted small">(1 cajuela ≈ @Model.KilogramosPorCajuela.ToString("N2") kg)</span>
        </div>
    </div>

    <div class="col-12">
        <label asp-for="Observaciones" class="form-label"></label>
        <input asp-for="Observaciones" class="form-control" />
    </div>
</div>

<script>
    (function () {
        var factor = @Model.KilogramosPorCajuela.ToString(System.Globalization.CultureInfo.InvariantCulture);
        var caj = document.getElementById("cajuelas");
        var out = document.getElementById("pesoPreview");
        function calc() {
            var v = (parseFloat(caj.value) || 0) * factor;
            out.textContent = v.toLocaleString("es-CR", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + " kg";
        }
        if (caj) { caj.addEventListener("input", calc); calc(); }
    })();
</script>
