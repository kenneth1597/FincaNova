@model RegistroProduccionFormViewModel

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="LoteId" class="form-label"></label>
        <select asp-for="LoteId" class="form-select">
            <option value="">— Seleccione el lote —</option>
            @foreach (var (id, t) in Model.Lotes) { <option value="@id" selected="@(Model.LoteId == id)">@t</option> }
        </select>
        <span asp-validation-for="LoteId" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="PeriodoProductivoId" class="form-label"></label>
        <select asp-for="PeriodoProductivoId" class="form-select">
            <option value="">— Seleccione el período —</option>
            @foreach (var (id, t) in Model.Periodos) { <option value="@id" selected="@(Model.PeriodoProductivoId == id)">@t</option> }
        </select>
        <span asp-validation-for="PeriodoProductivoId" class="text-danger small"></span>
    </div>

    <div class="col-md-5">
        <label asp-for="Etapa" class="form-label"></label>
        <select asp-for="Etapa" class="form-select">
            <option value="@((int)EtapaProduccion.CafeSeco)">@Ui.EtapaProduccionTexto(EtapaProduccion.CafeSeco)</option>
            <option value="@((int)EtapaProduccion.CafeProcesado)">@Ui.EtapaProduccionTexto(EtapaProduccion.CafeProcesado)</option>
        </select>
        <span asp-validation-for="Etapa" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Fecha" class="form-label"></label>
        <input asp-for="Fecha" class="form-control" type="date" />
    </div>
    <div class="col-md-4">
        <label asp-for="PesoKg" class="form-label"></label>
        <input asp-for="PesoKg" class="form-control" type="number" step="0.01" min="0" />
        <span asp-validation-for="PesoKg" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <label asp-for="Observaciones" class="form-label"></label>
        <textarea asp-for="Observaciones" class="form-control" rows="2"></textarea>
    </div>
</div>
