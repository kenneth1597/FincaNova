@model ProduccionResumenViewModel
@{
    ViewData["Title"] = "Producción y merma";
}

<h1 class="fn-page-title"><i class="bi bi-droplet-half"></i> Producción y merma</h1>
<p class="text-muted">Compara el peso del café en cada etapa del beneficiado y calcula la merma (HU-14, HU-15).</p>

<form method="get" class="fn-card mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-12 col-md-5">
            <label class="form-label small text-muted">Lote</label>
            <select name="loteId" class="form-select">
                <option value="">— Seleccione —</option>
                @foreach (var (id, t) in Model.Lotes) { <option value="@id" selected="@(Model.LoteId == id)">@t</option> }
            </select>
        </div>
        <div class="col-12 col-md-5">
            <label class="form-label small text-muted">Período productivo</label>
            <select name="periodoId" class="form-select">
                <option value="">— Seleccione —</option>
                @foreach (var (id, t) in Model.Periodos) { <option value="@id" selected="@(Model.PeriodoId == id)">@t</option> }
            </select>
        </div>
        <div class="col-12 col-md-2 d-grid">
            <button type="submit" class="btn btn-primary"><i class="bi bi-calculator"></i> Ver</button>
        </div>
    </div>
</form>

@if (!Model.Calculado)
{
    <div class="fn-card text-center text-muted py-4">
        <i class="bi bi-cup-hot d-block fs-3 mb-1"></i>
        Seleccione un lote y un período para ver la producción y la merma.
    </div>
}
else
{
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 gap-2">
        <h2 class="h5 mb-0">@Model.LoteNombre — @Model.PeriodoNombre</h2>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-primary btn-sm" asp-action="Crear" asp-route-loteId="@Model.LoteId" asp-route-periodoId="@Model.PeriodoId" asp-route-etapa="@((int)EtapaProduccion.CafeSeco)">
                <i class="bi bi-plus-lg"></i> Café seco
            </a>
            <a class="btn btn-outline-primary btn-sm" asp-action="Crear" asp-route-loteId="@Model.LoteId" asp-route-periodoId="@Model.PeriodoId" asp-route-etapa="@((int)EtapaProduccion.CafeProcesado)">
                <i class="bi bi-plus-lg"></i> Café procesado
            </a>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-6 col-lg-3">
            <div class="fn-card h-100">
                <div class="text-muted small text-uppercase">Recolectado (estimado)</div>
                <div class="fs-4 fw-bold text-primary">@Ui.Kg(Model.KgRecolectadoEstimado)</div>
                <div class="text-muted small">@Model.Cajuelas.ToString("N2") cajuelas</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="fn-card h-100">
                <div class="text-muted small text-uppercase">Café seco</div>
                <div class="fs-4 fw-bold text-primary">@Ui.Kg(Model.KgCafeSeco)</div>
                <div class="text-muted small">merma secado: @Ui.Kg(Model.MermaSecadoKg) (@Model.MermaSecadoPct%)</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="fn-card h-100">
                <div class="text-muted small text-uppercase">Café procesado</div>
                <div class="fs-4 fw-bold text-primary">@Ui.Kg(Model.KgCafeProcesado)</div>
                <div class="text-muted small">merma proceso: @Ui.Kg(Model.MermaProcesoKg) (@Model.MermaProcesoPct%)</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="fn-card h-100">
                <div class="text-muted small text-uppercase">Rendimiento global</div>
                <div class="fs-4 fw-bold @(Model.RendimientoGlobalPct > 0 ? "text-primary" : "text-muted")">@Model.RendimientoGlobalPct%</div>
                <div class="text-muted small">procesado / recolectado</div>
            </div>
        </div>
    </div>

    <div class="fn-card p-0">
        <h2 class="h6 text-muted text-uppercase p-3 pb-0">Registros de peso por etapa</h2>
        <div class="table-responsive">
            <table class="table fn-table align-middle mb-0">
                <thead><tr><th>Fecha</th><th>Etapa</th><th class="text-end">Peso</th><th>Observaciones</th><th></th></tr></thead>
                <tbody>
                @if (Model.Registros.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-3">Sin registros de café seco o procesado para este lote y período.</td></tr>
                }
                @foreach (var r in Model.Registros)
                {
                    <tr>
                        <td>@r.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>@Ui.EtapaProduccionTexto(r.Etapa)</td>
                        <td class="text-end">@Ui.Kg(r.PesoKg)</td>
                        <td class="small">@r.Observaciones</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Editar" asp-route-id="@r.Id"><i class="bi bi-pencil"></i></a>
                            @if (User.IsInRole(Roles.Administrador) || User.IsInRole(Roles.Caficultor))
                            {
                                <form asp-action="Eliminar" asp-route-id="@r.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('¿Eliminar este registro?');">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
