@model EnfermedadFiltroViewModel
@{
    ViewData["Title"] = "Control de enfermedades";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="fn-page-title mb-0"><i class="bi bi-bug"></i> Control de enfermedades</h1>
    <a class="btn btn-primary" asp-action="Crear"><i class="bi bi-plus-lg"></i> Registrar detección</a>
</div>

<form method="get" class="fn-card mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-6 col-md-3">
            <label class="form-label small text-muted">Lote</label>
            <select name="loteId" class="form-select">
                <option value="">Todos</option>
                @foreach (var (id, t) in Model.Lotes)
                {
                    <option value="@id" selected="@(Model.LoteId == id)">@t</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label small text-muted">Enfermedad / plaga</label>
            <select name="tipoEnfermedadId" class="form-select">
                <option value="">Todas</option>
                @foreach (var (id, t) in Model.Tipos)
                {
                    <option value="@id" selected="@(Model.TipoEnfermedadId == id)">@t</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small text-muted">Estado</label>
            <select name="estado" class="form-select">
                <option value="">Todos</option>
                @foreach (var e in Enum.GetValues<EstadoEnfermedad>())
                {
                    <option value="@((int)e)" selected="@(Model.Estado == e)">@Ui.EstadoEnfermedadTexto(e)</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small text-muted">Desde</label>
            <input type="date" name="desde" value="@(Model.Desde?.ToString("yyyy-MM-dd"))" class="form-control" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small text-muted">Hasta</label>
            <input type="date" name="hasta" value="@(Model.Hasta?.ToString("yyyy-MM-dd"))" class="form-control" />
        </div>
        <div class="col-8 col-md-3">
            <label class="form-label small text-muted">Tratamiento contiene</label>
            <input type="text" name="tratamiento" value="@Model.Tratamiento" class="form-control" placeholder="Ej. fungicida, poda sanitaria" />
        </div>
        <div class="col-4 col-md-2 d-grid">
            <button type="submit" class="btn btn-outline-primary"><i class="bi bi-search"></i> Filtrar</button>
        </div>
    </div>
</form>

<div class="fn-card p-0">
    <div class="table-responsive">
        <table class="table fn-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Lote</th>
                    <th>Enfermedad / plaga</th>
                    <th>Estado</th>
                    <th class="text-end">Tratam.</th>
                    <th>Último tratamiento</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Resultados.Count == 0)
            {
                <tr><td colspan="7" class="text-center text-muted py-4">
                    <i class="bi bi-clipboard2-pulse d-block fs-3 mb-1"></i>
                    No hay detecciones registradas con esos criterios.
                </td></tr>
            }
            @foreach (var r in Model.Resultados)
            {
                <tr>
                    <td>@r.FechaDeteccion.ToString("dd/MM/yyyy")</td>
                    <td>@r.Lote</td>
                    <td class="fw-semibold">@r.Enfermedad</td>
                    <td><span class="badge bg-@Ui.EstadoEnfermedadColor(r.Estado) fn-badge-estado">@Ui.EstadoEnfermedadTexto(r.Estado)</span></td>
                    <td class="text-end">@r.Tratamientos</td>
                    <td class="small">@(r.UltimoTratamiento ?? "—")</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Detalle" asp-route-id="@r.Id"><i class="bi bi-eye"></i></a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
