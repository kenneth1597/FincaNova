@model TratamientoFormViewModel
@{
    ViewData["Title"] = "Registrar tratamiento";
}

<h1 class="fn-page-title"><i class="bi bi-eyedropper"></i> Registrar tratamiento</h1>
<p class="text-muted">Enfermedad: <strong>@Model.Enfermedad</strong> · Lote: <strong>@Model.Lote</strong></p>

<div class="fn-card" style="max-width:720px">
    <form asp-action="Crear" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
        <input type="hidden" asp-for="RegistroEnfermedadId" />
        <input type="hidden" asp-for="Enfermedad" />
        <input type="hidden" asp-for="Lote" />

        <div class="row g-3">
            <div class="col-12">
                <label asp-for="Descripcion" class="form-label"></label>
                <input asp-for="Descripcion" class="form-control" placeholder="Ej. Aplicación de fungicida cúprico, poda sanitaria" />
                <span asp-validation-for="Descripcion" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Producto" class="form-label"></label>
                <input asp-for="Producto" class="form-control" placeholder="Ej. Oxicloruro de cobre" />
            </div>
            <div class="col-md-3">
                <label asp-for="Dosis" class="form-label"></label>
                <input asp-for="Dosis" class="form-control" placeholder="Ej. 3 g/L" />
            </div>
            <div class="col-md-3">
                <label asp-for="FechaAplicacion" class="form-label"></label>
                <input asp-for="FechaAplicacion" class="form-control" type="date" />
            </div>

            <div class="col-12"><hr class="my-1" /><span class="form-text">Opcional: descontar el producto del inventario (HU-24).</span></div>
            <div class="col-md-7">
                <label asp-for="InsumoId" class="form-label"></label>
                <select asp-for="InsumoId" class="form-select">
                    <option value="">— No descontar del inventario —</option>
                    @foreach (var (id, t) in Model.Insumos) { <option value="@id">@t</option> }
                </select>
            </div>
            <div class="col-md-5">
                <label asp-for="CantidadInsumo" class="form-label"></label>
                <input asp-for="CantidadInsumo" class="form-control" type="number" step="0.0001" min="0" />
                <span asp-validation-for="CantidadInsumo" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="ResultadoObservado" class="form-label"></label>
                <textarea asp-for="ResultadoObservado" class="form-control" rows="2"></textarea>
            </div>
        </div>

        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Guardar tratamiento</button>
            <a asp-controller="Enfermedades" asp-action="Detalle" asp-route-id="@Model.RegistroEnfermedadId" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
