@model RestablecerContrasenaViewModel
@{
    ViewData["Title"] = "Nueva contraseña";
    Layout = "_LayoutAuth";
}

<p class="text-center text-muted mb-4">Defina la nueva contraseña para <strong>@Model.Email</strong>.</p>

<form asp-action="RestablecerContrasena" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
    <input type="hidden" asp-for="Email" />
    <input type="hidden" asp-for="Token" />

    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" autofocus />
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ConfirmarPassword" class="form-label"></label>
        <input asp-for="ConfirmarPassword" class="form-control" />
        <span asp-validation-for="ConfirmarPassword" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100"><i class="bi bi-check-lg"></i> Guardar contraseña</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
