@{
    ViewData["Title"] = "Contraseña actualizada";
    Layout = "_LayoutAuth";
}

<div class="text-center">
    <i class="bi bi-shield-check text-success" style="font-size:2.5rem"></i>
    <p class="mt-3 mb-4">Su contraseña fue actualizada. Ya puede iniciar sesión con la nueva credencial.</p>
    <a asp-action="Login" class="btn btn-primary w-100"><i class="bi bi-box-arrow-in-right"></i> Iniciar sesión</a>
</div>
