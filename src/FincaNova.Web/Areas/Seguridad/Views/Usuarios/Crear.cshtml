@model CrearUsuarioViewModel
@{
    ViewData["Title"] = "Nuevo usuario";
}

<h1 class="fn-page-title">Nuevo usuario</h1>

<div class="fn-card" style="max-width:640px">
    <form asp-action="Crear" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Apellidos" class="form-label"></label>
                <input asp-for="Apellidos" class="form-control" />
                <span asp-validation-for="Apellidos" class="text-danger small"></span>
            </div>
            <div class="col-md-7">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="col-md-5">
                <label asp-for="Telefono" class="form-label"></label>
                <input asp-for="Telefono" class="form-control" />
                <span asp-validation-for="Telefono" class="text-danger small"></span>
            </div>
            <div class="col-md-5">
                <label asp-for="Rol" class="form-label"></label>
                <select asp-for="Rol" class="form-select">
                    <option value="">— Seleccione —</option>
                    @foreach (var r in Model.RolesDisponibles)
                    {
                        <option value="@r">@r</option>
                    }
                </select>
                <span asp-validation-for="Rol" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="ConfirmarPassword" class="form-label"></label>
                <input asp-for="ConfirmarPassword" class="form-control" />
                <span asp-validation-for="ConfirmarPassword" class="text-danger small"></span>
            </div>
        </div>

        <p class="form-text mt-2">
            La contraseña debe tener al menos 8 caracteres e incluir mayúscula, minúscula y número.
            El usuario podrá cambiarla luego mediante «¿Olvidó su contraseña?».
        </p>

        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Crear usuario</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
