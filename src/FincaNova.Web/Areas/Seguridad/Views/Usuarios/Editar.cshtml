@model EditarUsuarioViewModel
@{
    ViewData["Title"] = "Editar usuario";
}

<h1 class="fn-page-title">Editar usuario</h1>

<div class="fn-card" style="max-width:640px">
    <form asp-action="Editar" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="RolOriginal" />
        <input type="hidden" asp-for="EsUsuarioActual" />

        <div class="mb-3">
            <label class="form-label">Correo electrónico</label>
            <input value="@Model.Email" class="form-control" disabled />
            <span class="form-text">El correo identifica la cuenta y no puede modificarse.</span>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Apellidos" class="form-label"></label>
                <input asp-for="Apellidos" class="form-control" />
                <span asp-validation-for="Apellidos" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Telefono" class="form-label"></label>
                <input asp-for="Telefono" class="form-control" />
                <span asp-validation-for="Telefono" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Rol" class="form-label"></label>
                <select asp-for="Rol" class="form-select" disabled="@Model.EsUsuarioActual" id="rolSelect">
                    @foreach (var r in Model.RolesDisponibles)
                    {
                        <option value="@r" selected="@(r == Model.Rol)">@r</option>
                    }
                </select>
                @if (Model.EsUsuarioActual)
                {
                    <input type="hidden" asp-for="Rol" />
                    <span class="form-text">No puede cambiar su propio rol.</span>
                }
                <span asp-validation-for="Rol" class="text-danger small"></span>
            </div>

            <div class="col-12" id="confirmPwdBlock" style="display:none">
                <label asp-for="PasswordConfirmacion" class="form-label"></label>
                <input asp-for="PasswordConfirmacion" class="form-control" />
                <span class="form-text">Requerido para otorgar permisos de Administrador (HU-49).</span>
                <span asp-validation-for="PasswordConfirmacion" class="text-danger small"></span>
            </div>
        </div>

        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Guardar cambios</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var rolOriginal = @Html.Raw(Json.Serialize(Model.RolOriginal));
            var select = document.getElementById("rolSelect");
            var block = document.getElementById("confirmPwdBlock");
            function refrescar() {
                var escala = select && select.value === "Administrador" && rolOriginal !== "Administrador";
                block.style.display = escala ? "block" : "none";
            }
            if (select) { select.addEventListener("change", refrescar); refrescar(); }
        })();
    </script>
}
