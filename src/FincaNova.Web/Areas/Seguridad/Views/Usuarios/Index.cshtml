@model IReadOnlyList<UsuarioListItemViewModel>
@{
    ViewData["Title"] = "Usuarios y roles";
    var roles = (string[])ViewBag.Roles;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="fn-page-title mb-0">Usuarios y roles</h1>
    <a class="btn btn-primary" asp-action="Crear">
        <i class="bi bi-person-plus"></i> Nuevo usuario
    </a>
</div>

<form method="get" class="fn-card mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-12 col-md-4">
            <label class="form-label small text-muted">Buscar por nombre o correo</label>
            <input type="text" name="q" value="@ViewBag.Query" class="form-control" placeholder="Ej. María o su correo" />
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label small text-muted">Rol</label>
            <select name="rol" class="form-select">
                <option value="">Todos</option>
                @foreach (var r in roles)
                {
                    <option value="@r" selected="@(ViewBag.Rol as string == r)">@r</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label small text-muted">Estado</label>
            <select name="estado" class="form-select">
                <option value="">Todos</option>
                <option value="activos" selected="@(ViewBag.Estado as string == "activos")">Activos</option>
                <option value="inactivos" selected="@(ViewBag.Estado as string == "inactivos")">Inactivos</option>
            </select>
        </div>
        <div class="col-12 col-md-2 d-grid">
            <button type="submit" class="btn btn-outline-primary"><i class="bi bi-search"></i> Filtrar</button>
        </div>
    </div>
</form>

<div class="fn-card p-0">
    <div class="table-responsive">
        <table class="table fn-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Correo</th>
                    <th>Teléfono</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-muted py-4">No se encontraron usuarios con los criterios indicados.</td></tr>
            }
            @foreach (var u in Model)
            {
                <tr>
                    <td class="fw-semibold">@u.NombreCompleto</td>
                    <td>@u.Email</td>
                    <td>@(string.IsNullOrEmpty(u.Telefono) ? "—" : u.Telefono)</td>
                    <td><span class="badge bg-primary-subtle text-primary fn-badge-estado">@u.Rol</span></td>
                    <td>
                        @if (!u.Activo)
                        {
                            <span class="badge bg-secondary fn-badge-estado">Inactivo</span>
                        }
                        else if (u.Bloqueado)
                        {
                            <span class="badge bg-warning text-dark fn-badge-estado">Bloqueado</span>
                        }
                        else
                        {
                            <span class="badge bg-success fn-badge-estado">Activo</span>
                        }
                    </td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Editar" asp-route-id="@u.Id" title="Editar">
                            <i class="bi bi-pencil"></i>
                        </a>
                        @if (u.Bloqueado)
                        {
                            <form asp-action="Desbloquear" asp-route-id="@u.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-warning" title="Desbloquear"><i class="bi bi-unlock"></i></button>
                            </form>
                        }
                        <form asp-action="CambiarEstado" asp-route-id="@u.Id" method="post" class="d-inline"
                              onsubmit="return confirm('¿Confirma cambiar el estado de acceso de este usuario?');">
                            @Html.AntiForgeryToken()
                            @if (u.Activo)
                            {
                                <button class="btn btn-sm btn-outline-danger" title="Inactivar"><i class="bi bi-person-x"></i></button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-success" title="Reactivar"><i class="bi bi-person-check"></i></button>
                            }
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
