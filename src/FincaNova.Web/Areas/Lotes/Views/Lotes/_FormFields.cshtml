@model LoteFormViewModel

<div class="row g-3">
    <div class="col-md-4">
        <label asp-for="Codigo" class="form-label"></label>
        <input asp-for="Codigo" class="form-control" disabled="@Model.EsEdicion" />
        @if (Model.EsEdicion)
        {
            <input type="hidden" asp-for="Codigo" />
            <span class="form-text">El código es la referencia histórica del lote y no se modifica.</span>
        }
        <span asp-validation-for="Codigo" class="text-danger small"></span>
    </div>
    <div class="col-md-8">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" placeholder="Ej. Lote Norte" />
        <span asp-validation-for="Nombre" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Tipo" class="form-label"></label>
        <select asp-for="Tipo" class="form-select" id="tipoSelect" disabled="@Model.EsEdicion">
            <option value="@((int)TipoLote.Lote)">Lote</option>
            <option value="@((int)TipoLote.MicroLote)">Micro lote</option>
        </select>
        @if (Model.EsEdicion)
        {
            <input type="hidden" asp-for="Tipo" />
        }
    </div>
    <div class="col-md-8" id="padreBlock">
        <label asp-for="LotePadreId" class="form-label"></label>
        <select asp-for="LotePadreId" class="form-select">
            <option value="">— Seleccione el lote —</option>
            @foreach (var (pid, texto) in Model.LotesPadre)
            {
                <option value="@pid" selected="@(Model.LotePadreId == pid)">@texto</option>
            }
        </select>
        <span asp-validation-for="LotePadreId" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="AreaHectareas" class="form-label"></label>
        <input asp-for="AreaHectareas" class="form-control" type="number" step="0.01" min="0" />
        <span asp-validation-for="AreaHectareas" class="text-danger small"></span>
    </div>
    <div class="col-md-5">
        <label asp-for="VariedadCafe" class="form-label"></label>
        <input asp-for="VariedadCafe" class="form-control" list="variedades" placeholder="Ej. Caturra" />
        <datalist id="variedades">
            <option value="Caturra"></option>
            <option value="Catuaí"></option>
            <option value="Typica"></option>
            <option value="Bourbon"></option>
            <option value="Geisha"></option>
            <option value="Villa Sarchí"></option>
            <option value="Obatá"></option>
            <option value="Marsellesa"></option>
        </datalist>
    </div>
    <div class="col-md-3">
        <label asp-for="AnioSiembra" class="form-label"></label>
        <input asp-for="AnioSiembra" class="form-control" type="number" min="1900" max="2100" placeholder="@DateTime.Now.Year" />
        <span asp-validation-for="AnioSiembra" class="text-danger small"></span>
    </div>

    <div class="col-md-8">
        <label asp-for="Ubicacion" class="form-label"></label>
        <input asp-for="Ubicacion" class="form-control" placeholder="Referencia dentro de la finca" />
    </div>

    <div class="col-12">
        <label asp-for="Observaciones" class="form-label"></label>
        <textarea asp-for="Observaciones" class="form-control" rows="2"></textarea>
    </div>
</div>

<script>
    (function () {
        var tipo = document.getElementById("tipoSelect");
        var padre = document.getElementById("padreBlock");
        function refrescar() {
            var esMicro = tipo && tipo.value === "@((int)TipoLote.MicroLote)";
            padre.style.display = esMicro ? "" : "none";
        }
        if (tipo) { tipo.addEventListener("change", refrescar); }
        refrescar();
    })();
</script>
