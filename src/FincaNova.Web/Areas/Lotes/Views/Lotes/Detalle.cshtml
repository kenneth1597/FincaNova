@model LoteDetalleViewModel
@{
    var l = Model.Lote;
    ViewData["Title"] = $"Lote {l.Codigo}";
    var puedeGestionar = User.IsInRole(Roles.Administrador) || User.IsInRole(Roles.Caficultor);
}

<div class="d-flex flex-wrap justify-content-between align-items-start mb-3 gap-2">
    <div>
        <h1 class="fn-page-title mb-1">
            <i class="bi bi-@(l.Tipo == TipoLote.MicroLote ? "diagram-3" : "map")"></i>
            @l.Codigo — @l.Nombre
        </h1>
        <span class="badge bg-@Ui.EstadoLoteColor(l.Estado) fn-badge-estado">@Ui.EstadoLoteTexto(l.Estado)</span>
        <span class="text-muted small">· @Ui.TipoLoteTexto(l.Tipo)</span>
        @if (l.LotePadre != null)
        {
            <span class="text-muted small">· pertenece a
                <a asp-action="Detalle" asp-route-id="@l.LotePadreId">@l.LotePadre.Codigo</a>
            </span>
        }
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Volver</a>
        @if (puedeGestionar)
        {
            <a asp-action="Editar" asp-route-id="@l.Id" class="btn btn-primary btn-sm"><i class="bi bi-pencil"></i> Editar</a>
        }
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="fn-card h-100">
            <h2 class="h6 text-muted text-uppercase">Ficha técnica</h2>
            <dl class="row mb-0 small">
                <dt class="col-6">Área</dt><dd class="col-6">@l.AreaHectareas.ToString("N2") ha</dd>
                <dt class="col-6">Variedad</dt><dd class="col-6">@(l.VariedadCafe ?? "—")</dd>
                <dt class="col-6">Año de siembra</dt><dd class="col-6">@(l.AnioSiembra?.ToString() ?? "—")</dd>
                <dt class="col-6">Ubicación</dt><dd class="col-6">@(l.Ubicacion ?? "—")</dd>
                <dt class="col-6">Registrado</dt><dd class="col-6">@l.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy")</dd>
                <dt class="col-6">Último cambio de estado</dt>
                <dd class="col-6">
                    @(l.FechaUltimoCambioEstado?.ToLocalTime().ToString("dd/MM/yyyy") ?? "—")
                    @if (!string.IsNullOrEmpty(l.EstadoCambiadoPor)) { <span class="d-block text-muted">por @l.EstadoCambiadoPor</span> }
                </dd>
            </dl>
            @if (!string.IsNullOrEmpty(l.Observaciones))
            {
                <hr />
                <p class="small mb-0">@l.Observaciones</p>
            }
        </div>
    </div>

    @if (puedeGestionar)
    {
        <div class="col-lg-4">
            <div class="fn-card h-100">
                <h2 class="h6 text-muted text-uppercase">Estado operativo</h2>
                <form asp-action="CambiarEstado" method="post" class="d-flex gap-2 align-items-end">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@l.Id" />
                    <div class="flex-grow-1">
                        <label class="form-label small">Cambiar a</label>
                        <select name="estado" class="form-select form-select-sm">
                            @foreach (var e in Enum.GetValues<EstadoLote>())
                            {
                                if (e != l.Estado && e != EstadoLote.Inactivo)
                                {
                                    <option value="@((int)e)">@Ui.EstadoLoteTexto(e)</option>
                                }
                            }
                        </select>
                    </div>
                    <button class="btn btn-outline-primary btn-sm">Aplicar</button>
                </form>
                <hr />
                <p class="small text-muted mb-2">Al inactivar, el lote deja de aparecer en los formularios de operación pero se conserva todo su historial.</p>
                <form asp-action="Desactivar" method="post"
                      onsubmit="return confirm('¿Inactivar el lote @l.Codigo? Su historial se conserva.');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@l.Id" />
                    <button class="btn btn-outline-danger btn-sm" @(l.Estado == EstadoLote.Inactivo ? "disabled" : "")>
                        <i class="bi bi-slash-circle"></i> Inactivar lote
                    </button>
                </form>
            </div>
        </div>
    }

    <div class="col-lg-4">
        <div class="fn-card h-100">
            <div class="d-flex justify-content-between align-items-center">
                <h2 class="h6 text-muted text-uppercase mb-0">Micro lotes</h2>
                @if (puedeGestionar && l.Tipo == TipoLote.Lote)
                {
                    <a class="btn btn-outline-primary btn-sm"
                       asp-action="Crear" asp-route-tipo="@((int)TipoLote.MicroLote)" asp-route-padreId="@l.Id">
                        <i class="bi bi-plus-lg"></i>
                    </a>
                }
            </div>
            @if (Model.MicroLotes.Count == 0)
            {
                <p class="small text-muted mt-2 mb-0">Sin micro lotes.</p>
            }
            else
            {
                <ul class="list-unstyled small mt-2 mb-0">
                    @foreach (var m in Model.MicroLotes)
                    {
                        <li class="d-flex justify-content-between border-bottom py-1">
                            <a asp-action="Detalle" asp-route-id="@m.Id">@m.Codigo — @m.Nombre</a>
                            <span class="badge bg-@Ui.EstadoLoteColor(m.Estado) fn-badge-estado">@Ui.EstadoLoteTexto(m.Estado)</span>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>

<div class="fn-card mt-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h2 class="h5 mb-0"><i class="bi bi-clock-history"></i> Bitácora del lote</h2>
        <form method="get" class="d-flex gap-2 align-items-end">
            <input type="hidden" name="id" value="@l.Id" />
            <div>
                <label class="form-label small text-muted mb-0">Desde</label>
                <input type="date" name="desde" value="@(Model.Desde?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>
            <div>
                <label class="form-label small text-muted mb-0">Hasta</label>
                <input type="date" name="hasta" value="@(Model.Hasta?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>
            <button class="btn btn-outline-primary btn-sm">Filtrar</button>
        </form>
    </div>

    @if (Model.Bitacora.Count == 0)
    {
        <p class="text-muted mb-0">
            <i class="bi bi-cup-hot"></i>
            Todavía no hay actividades registradas en este lote. A medida que se registren
            labores, enfermedades, recolecciones y gastos, aparecerán aquí en orden cronológico.
        </p>
    }
    else
    {
        <ul class="fn-timeline">
            @foreach (var item in Model.Bitacora)
            {
                <li>
                    <span class="fn-timeline__dot bg-@item.Color"><i class="bi @item.Icono"></i></span>
                    <div>
                        <div class="d-flex justify-content-between">
                            <strong>@item.Descripcion</strong>
                            <span class="text-muted small">@item.Fecha.ToLocalTime().ToString("dd/MM/yyyy")</span>
                        </div>
                        <div class="text-muted small">@item.Tipo@(string.IsNullOrEmpty(item.Detalle) ? "" : $" · {item.Detalle}")</div>
                    </div>
                </li>
            }
        </ul>
    }
</div>
