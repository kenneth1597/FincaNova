@model IReadOnlyList<PeriodoListItemViewModel>
@{
    ViewData["Title"] = "Períodos productivos";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="fn-page-title mb-0"><i class="bi bi-calendar-range"></i> Períodos productivos</h1>
    <a class="btn btn-primary" asp-action="Crear"><i class="bi bi-plus-lg"></i> Nuevo período</a>
</div>

<p class="text-muted">Cada temporada de cosecha (normalmente de noviembre a enero) organiza la producción y las finanzas. Solo un período puede estar activo.</p>

<div class="fn-card p-0">
    <div class="table-responsive">
        <table class="table fn-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Inicio</th>
                    <th>Fin</th>
                    <th class="text-end">Recolecciones</th>
                    <th class="text-end">Labores</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="7" class="text-center text-muted py-4">
                    <i class="bi bi-cup-hot d-block fs-3 mb-1"></i>
                    Aún no hay períodos productivos. Cree el primero para empezar a registrar cosechas.
                </td></tr>
            }
            @foreach (var p in Model)
            {
                <tr>
                    <td class="fw-semibold">@p.Nombre</td>
                    <td>@p.FechaInicio.ToString("dd/MM/yyyy")</td>
                    <td>@p.FechaFin.ToString("dd/MM/yyyy")</td>
                    <td class="text-end">@p.Recolecciones</td>
                    <td class="text-end">@p.Labores</td>
                    <td>
                        @if (p.Activo)
                        {
                            <span class="badge bg-success fn-badge-estado">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary fn-badge-estado">Cerrado</span>
                        }
                    </td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Editar" asp-route-id="@p.Id" title="Editar">
                            <i class="bi bi-pencil"></i>
                        </a>
                        @if (!p.Activo)
                        {
                            <form asp-action="Activar" asp-route-id="@p.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('¿Marcar «@p.Nombre» como el período activo?');">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-success" title="Marcar como activo">
                                    <i class="bi bi-check2-circle"></i>
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
