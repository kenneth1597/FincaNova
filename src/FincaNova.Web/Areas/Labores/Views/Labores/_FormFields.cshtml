@model LaborFormViewModel

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="TipoLabor" class="form-label"></label>
        <input asp-for="TipoLabor" class="form-control" list="tiposLabor" placeholder="Ej. Poda, Fertilización, Limpia" />
        <datalist id="tiposLabor">
            <option value="Poda"></option>
            <option value="Fertilización"></option>
            <option value="Control de maleza / Limpia"></option>
            <option value="Aplicación fitosanitaria / Atomización"></option>
            <option value="Deshija"></option>
            <option value="Aporca"></option>
            <option value="Siembra / Resiembra"></option>
        </datalist>
        <span asp-validation-for="TipoLabor" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Fecha" class="form-label"></label>
        <input asp-for="Fecha" class="form-control" type="date" />
        <span asp-validation-for="Fecha" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="PeriodoProductivoId" class="form-label"></label>
        <select asp-for="PeriodoProductivoId" class="form-select">
            <option value="">Sin período</option>
            @foreach (var (pid, texto) in Model.Periodos)
            {
                <option value="@pid" selected="@(Model.PeriodoProductivoId == pid)">@texto</option>
            }
        </select>
    </div>

    <div class="col-md-6">
        <label asp-for="LoteId" class="form-label"></label>
        <select asp-for="LoteId" class="form-select">
            <option value="">— Seleccione el lote —</option>
            @foreach (var (lid, texto) in Model.Lotes)
            {
                <option value="@lid" selected="@(Model.LoteId == lid)">@texto</option>
            }
        </select>
        <span asp-validation-for="LoteId" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Modalidad" class="form-label"></label>
        <select asp-for="Modalidad" class="form-select" id="modalidad">
            <option value="@((int)ModalidadPago.PorJornada)">Por jornada</option>
            <option value="@((int)ModalidadPago.PorHora)">Por hora</option>
        </select>
    </div>
    <div class="col-md-3">
        <label asp-for="Cantidad" class="form-label"></label>
        <input asp-for="Cantidad" class="form-control" type="number" step="0.25" min="0" id="cantidad" />
        <span asp-validation-for="Cantidad" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="CostoUnitario" class="form-label"></label>
        <input asp-for="CostoUnitario" class="form-control" type="number" step="0.01" min="0" id="tarifaOverride" />
        <span class="form-text">Si es 0, se usa la tarifa de cada colaborador.</span>
    </div>
    <div class="col-md-8">
        <label asp-for="Observaciones" class="form-label"></label>
        <input asp-for="Observaciones" class="form-control" />
    </div>

    <div class="col-12">
        <label class="form-label">Colaboradores <span class="text-danger">*</span></label>
        <div class="row g-2" id="colaboradores">
            @if (!Model.Colaboradores.Any())
            {
                <p class="text-muted small">No hay colaboradores activos. Registre colaboradores antes de crear labores.</p>
            }
            @foreach (var c in Model.Colaboradores)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="form-check border rounded p-2 ps-4">
                        <input class="form-check-input col-check" type="checkbox" name="ColaboradorIds" value="@c.Id"
                               id="col-@c.Id" data-jornada="@c.TarifaJornada" data-hora="@c.TarifaHora"
                               @(Model.ColaboradorIds.Contains(c.Id) ? "checked" : "") />
                        <label class="form-check-label" for="col-@c.Id">
                            @c.Nombre <span class="text-muted small d-block">@c.Identificacion · J @c.TarifaJornada.ToString("N0") / H @c.TarifaHora.ToString("N0")</span>
                        </label>
                    </div>
                </div>
            }
        </div>
        <span asp-validation-for="ColaboradorIds" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <div class="alert alert-success py-2 mb-0">
            <i class="bi bi-calculator"></i>
            Costo estimado de la labor: <strong id="costoPreview">0.00</strong>
            <span class="text-muted small">(se recalcula al guardar)</span>
        </div>
    </div>
</div>

<script>
    (function () {
        var modalidad = document.getElementById("modalidad");
        var cantidad = document.getElementById("cantidad");
        var override = document.getElementById("tarifaOverride");
        var preview = document.getElementById("costoPreview");
        var checks = document.querySelectorAll(".col-check");

        function recalcular() {
            var cant = parseFloat(cantidad.value) || 0;
            var ov = parseFloat(override.value) || 0;
            var porHora = modalidad.value === "@((int)ModalidadPago.PorHora)";
            var total = 0;
            checks.forEach(function (ch) {
                if (!ch.checked) return;
                var tarifa = ov > 0 ? ov : parseFloat(ch.dataset[porHora ? "hora" : "jornada"]) || 0;
                total += cant * tarifa;
            });
            preview.textContent = total.toLocaleString("es-CR", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        [modalidad, cantidad, override].forEach(function (el) { el && el.addEventListener("input", recalcular); });
        checks.forEach(function (ch) { ch.addEventListener("change", recalcular); });
        recalcular();
    })();
</script>
