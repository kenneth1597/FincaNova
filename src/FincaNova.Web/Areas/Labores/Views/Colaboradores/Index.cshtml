@model IReadOnlyList<ColaboradorListItemViewModel>
@{
    ViewData["Title"] = "Colaboradores";
    var soloActivos = (bool)ViewBag.SoloActivos;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="fn-page-title mb-0"><i class="bi bi-person-badge"></i> Colaboradores</h1>
    <a class="btn btn-primary" asp-action="Crear"><i class="bi bi-person-plus"></i> Nuevo colaborador</a>
</div>

<form method="get" class="fn-card mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-12 col-md-6">
            <label class="form-label small text-muted">Buscar por nombre, identificación o cargo</label>
            <input type="text" name="q" value="@ViewBag.Query" class="form-control" placeholder="Ej. María, 1-1234-5678 o Peón" />
        </div>
        <div class="col-12 col-md-4">
            <div class="form-check mt-4">
                <input class="form-check-input" type="checkbox" name="soloActivos" value="true" id="soloActivos" @(soloActivos ? "checked" : "") />
                <label class="form-check-label" for="soloActivos">Mostrar solo colaboradores activos</label>
            </div>
        </div>
        <div class="col-12 col-md-2 d-grid">
            <button type="submit" class="btn btn-outline-primary"><i class="bi bi-search"></i> Filtrar</button>
        </div>
    </div>
</form>

<div class="fn-card p-0">
    <div class="table-responsive">
        <table class="table fn-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Identificación</th>
                    <th>Cargo</th>
                    <th class="text-end">Tarifa jornada</th>
                    <th class="text-end">Labores</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="7" class="text-center text-muted py-4">
                    <i class="bi bi-people d-block fs-3 mb-1"></i>
                    No hay colaboradores que coincidan.
                </td></tr>
            }
            @foreach (var c in Model)
            {
                <tr>
                    <td class="fw-semibold"><a asp-action="Detalle" asp-route-id="@c.Id" class="text-decoration-none">@c.Nombre</a></td>
                    <td>@c.Identificacion</td>
                    <td>@(string.IsNullOrEmpty(c.Cargo) ? "—" : c.Cargo)</td>
                    <td class="text-end">@Ui.Money(c.TarifaJornada)</td>
                    <td class="text-end">@c.Labores</td>
                    <td><span class="badge bg-@Ui.EstadoColaboradorColor(c.Estado) fn-badge-estado">@Ui.EstadoColaboradorTexto(c.Estado)</span></td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Detalle" asp-route-id="@c.Id" title="Ver"><i class="bi bi-eye"></i></a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Editar" asp-route-id="@c.Id" title="Editar"><i class="bi bi-pencil"></i></a>
                        <form asp-action="CambiarEstado" asp-route-id="@c.Id" method="post" class="d-inline"
                              onsubmit="return confirm('¿Cambiar el estado de @c.Nombre?');">
                            @Html.AntiForgeryToken()
                            @if (c.Estado == EstadoColaborador.Activo)
                            {
                                <button class="btn btn-sm btn-outline-danger" title="Inactivar"><i class="bi bi-person-x"></i></button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-success" title="Reactivar"><i class="bi bi-person-check"></i></button>
                            }
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
