@model DashboardViewModel
@{
    ViewData["Title"] = "Panel principal";
}

<h1 class="fn-page-title"><partial name="_BrandLogo" /> Panel principal — @Model.Finca</h1>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="fn-card h-100">
            <div class="text-muted small text-uppercase"><i class="bi bi-map"></i> Lotes registrados</div>
            <div class="fs-2 fw-bold text-primary">@Model.TotalLotes</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="fn-card h-100">
            <div class="text-muted small text-uppercase"><i class="bi bi-check2-circle"></i> Lotes en operación</div>
            <div class="fs-2 fw-bold text-primary">@Model.LotesEnOperacion</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="fn-card h-100">
            <div class="text-muted small text-uppercase"><i class="bi bi-calendar-range"></i> Período activo</div>
            <div class="fs-5 fw-semibold">@(Model.PeriodoActivo ?? "Sin definir")</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <a class="fn-card h-100 d-block text-decoration-none" asp-controller="Alertas" asp-action="Index">
            <div class="text-muted small text-uppercase"><i class="bi bi-bell"></i> Alertas pendientes</div>
            <div class="fs-2 fw-bold @(Model.AlertasPendientes > 0 ? "text-danger" : "text-primary")">@Model.AlertasPendientes</div>
        </a>
    </div>
</div>

<div class="fn-card">
    <h2 class="h5"><i class="bi bi-cup-hot"></i> Bienvenido a FincaNova</h2>
    <p class="text-muted mb-3">
        Sistema de gestión integral para la finca cafetalera. Use el menú lateral para acceder a los módulos.
        Disponibles: <strong>Seguridad</strong>, <strong>Lotes y micro lotes</strong>, <strong>Registro de labores</strong>,
        <strong>Control de enfermedades</strong> y <strong>Recolección y producción</strong>. Los módulos de finanzas
        y el tablero de indicadores se habilitan en las siguientes entregas.
    </p>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-primary btn-sm" asp-area="Lotes" asp-controller="Lotes" asp-action="Index">
            <i class="bi bi-map"></i> Lotes y micro lotes
        </a>
        <a class="btn btn-outline-primary btn-sm" asp-area="Lotes" asp-controller="Periodos" asp-action="Index">
            <i class="bi bi-calendar-range"></i> Períodos productivos
        </a>
        @if (User.IsInRole(Roles.Administrador))
        {
            <a class="btn btn-outline-primary btn-sm" asp-area="Seguridad" asp-controller="Usuarios" asp-action="Index">
                <i class="bi bi-people"></i> Usuarios y roles
            </a>
        }
    </div>
</div>
