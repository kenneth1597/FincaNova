@model DashboardViewModel
@{
    ViewData["Title"] = "Panel principal";
}

<h1 class="fn-page-title">Panel principal — @Model.Finca</h1>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="fn-card h-100">
            <div class="text-muted small text-uppercase">Lotes registrados</div>
            <div class="fs-2 fw-bold text-primary">@Model.TotalLotes</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="fn-card h-100">
            <div class="text-muted small text-uppercase">Lotes activos</div>
            <div class="fs-2 fw-bold text-primary">@Model.LotesActivos</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="fn-card h-100">
            <div class="text-muted small text-uppercase">Período activo</div>
            <div class="fs-5 fw-semibold">@(Model.PeriodoActivo ?? "Sin definir")</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="fn-card h-100">
            <div class="text-muted small text-uppercase">Alertas pendientes</div>
            <div class="fs-2 fw-bold @(Model.AlertasPendientes > 0 ? "text-danger" : "text-primary")">@Model.AlertasPendientes</div>
        </div>
    </div>
</div>

<div class="fn-card">
    <h2 class="h5">Bienvenido a FincaNova</h2>
    <p class="text-muted mb-3">
        Sistema de gestión integral para la finca cafetalera. Use el menú lateral para acceder a los módulos.
        El desarrollo avanza por hitos: <strong>Seguridad</strong> ya está disponible; los módulos de operación se
        habilitan en las siguientes entregas.
    </p>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-primary btn-sm" asp-area="Lotes" asp-controller="Lotes" asp-action="Index">
            <i class="bi bi-grid-3x3-gap"></i> Lotes y micro lotes
        </a>
        @if (User.IsInRole(Roles.Administrador))
        {
            <a class="btn btn-outline-primary btn-sm" asp-area="Seguridad" asp-controller="Usuarios" asp-action="Index">
                <i class="bi bi-people"></i> Usuarios y roles
            </a>
        }
    </div>
</div>
