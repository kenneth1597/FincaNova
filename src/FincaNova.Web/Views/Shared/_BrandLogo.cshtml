@*
    Logotipo de FincaNova: grano de café (elipse inclinada con su surco central).
    Usa currentColor, por lo que hereda el color del contexto. El tamaño se
    controla por CSS (.fn-logo) según dónde se coloque.
*@
<svg class="fn-logo" viewBox="0 0 32 32" fill="none"
     xmlns="http://www.w3.org/2000/svg" role="img" aria-label="FincaNova">
    <g transform="rotate(-20 16 16)">
        <ellipse cx="16" cy="16" rx="8.6" ry="12.6" fill="currentColor" opacity=".2" />
        <ellipse cx="16" cy="16" rx="8.6" ry="12.6" fill="none" stroke="currentColor" stroke-width="1.9" />
        <path d="M16 4.6C11.4 8.2 11.4 12.6 14.4 16.1 17.4 19.6 17.4 24 16 27.4"
              fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" />
    </g>
</svg>
