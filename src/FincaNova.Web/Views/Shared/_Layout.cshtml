@{
    var user = User?.Identity?.IsAuthenticated == true ? User.Identity!.Name : null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is null ? "FincaNova" : ViewData["Title"] + " · FincaNova")</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/fincanova.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FincaNova.Web.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
<div class="fn-shell">
    <partial name="_Sidebar" />
    <div class="fn-sidebar__backdrop" id="fnSidebarBackdrop"></div>

    <div class="fn-main">
        <header class="fn-topbar">
            <button class="fn-topbar__toggle" id="fnSidebarToggle" aria-label="Abrir menú">
                <i class="bi bi-list"></i>
            </button>
            <div class="fw-semibold d-none d-md-block">@ViewData["Title"]</div>
            <div class="dropdown ms-auto">
                <button class="btn btn-sm btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-person-circle"></i>
                    <span class="d-none d-sm-inline">@user</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><span class="dropdown-item-text small text-muted">Sesión iniciada como<br /><strong>@user</strong></span></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        <form asp-area="Seguridad" asp-controller="Cuenta" asp-action="Logout" method="post" class="px-1">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="dropdown-item text-danger">
                                <i class="bi bi-box-arrow-right"></i> Cerrar sesión
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </header>

        <main role="main" class="fn-content">
            @if (TempData["Ok"] is string ok)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle"></i> @ok
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] is string err)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle"></i> @err
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </main>

        <footer class="fn-content py-2 footer-note border-top">
            © 2026 FincaNova · Café Chaperno · Poás, Alajuela
        </footer>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/fincanova.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
