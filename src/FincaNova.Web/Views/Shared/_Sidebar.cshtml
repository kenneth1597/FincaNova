@{
    string Active(string area, string controller)
    {
        var ca = (ViewContext.RouteData.Values["area"] as string) ?? "";
        var cc = (ViewContext.RouteData.Values["controller"] as string) ?? "";
        return string.Equals(ca, area, StringComparison.OrdinalIgnoreCase)
               && string.Equals(cc, controller, StringComparison.OrdinalIgnoreCase)
            ? "active" : "";
    }
    var esAdmin = User.IsInRole(Roles.Administrador);
    var esGestion = User.IsInRole(Roles.Administrador) || User.IsInRole(Roles.Caficultor);
}
<nav class="fn-sidebar" id="fnSidebar">
    <div class="fn-sidebar__brand">
        <partial name="_BrandLogo" />
        FincaNova
    </div>
    <div class="fn-sidebar__nav">
        <a class="fn-sidebar__link @Active("", "Home")" asp-area="" asp-controller="Home" asp-action="Index">
            <i class="bi bi-speedometer2"></i> Panel principal
        </a>

        <div class="fn-sidebar__section">Operación</div>
        <a class="fn-sidebar__link @Active("Lotes", "Lotes")" asp-area="Lotes" asp-controller="Lotes" asp-action="Index">
            <i class="bi bi-map"></i> Lotes y micro lotes
        </a>
        <a class="fn-sidebar__link @Active("Labores", "Labores")" asp-area="Labores" asp-controller="Labores" asp-action="Index">
            <i class="bi bi-tools"></i> Registro de labores
        </a>
        @if (esGestion)
        {
            <a class="fn-sidebar__link @Active("Labores", "Colaboradores")" asp-area="Labores" asp-controller="Colaboradores" asp-action="Index">
                <i class="bi bi-person-badge"></i> Colaboradores
            </a>
            <a class="fn-sidebar__link @Active("Labores", "Planilla")" asp-area="Labores" asp-controller="Planilla" asp-action="Index">
                <i class="bi bi-cash-stack"></i> Planilla
            </a>
        }
        <a class="fn-sidebar__link @Active("Enfermedades", "Enfermedades")" asp-area="Enfermedades" asp-controller="Enfermedades" asp-action="Index">
            <i class="bi bi-bug"></i> Control de enfermedades
        </a>
        <a class="fn-sidebar__link @Active("Produccion", "Recoleccion")" asp-area="Produccion" asp-controller="Recoleccion" asp-action="Index">
            <i class="bi bi-basket"></i> Recolección y producción
        </a>

        <div class="fn-sidebar__section">Administración</div>
        @if (esGestion)
        {
            <a class="fn-sidebar__link @Active("Finanzas", "Finanzas")" asp-area="Finanzas" asp-controller="Finanzas" asp-action="Index">
                <i class="bi bi-cash-coin"></i> Ingresos y gastos
            </a>
            <a class="fn-sidebar__link @Active("Finanzas", "Inventario")" asp-area="Finanzas" asp-controller="Inventario" asp-action="Index">
                <i class="bi bi-box-seam"></i> Inventario de insumos
            </a>
        }
        <a class="fn-sidebar__link @Active("Lotes", "Periodos")" asp-area="Lotes" asp-controller="Periodos" asp-action="Index">
            <i class="bi bi-calendar-range"></i> Períodos productivos
        </a>
        @if (esGestion)
        {
            <a class="fn-sidebar__link @Active("", "Alertas")" asp-area="" asp-controller="Alertas" asp-action="Index">
                <i class="bi bi-bell"></i> Alertas
            </a>
        }
        @if (esAdmin)
        {
            <a class="fn-sidebar__link @Active("Seguridad", "Usuarios")" asp-area="Seguridad" asp-controller="Usuarios" asp-action="Index">
                <i class="bi bi-people"></i> Usuarios y roles
            </a>
            <a class="fn-sidebar__link @Active("Seguridad", "Auditoria")" asp-area="Seguridad" asp-controller="Auditoria" asp-action="Index">
                <i class="bi bi-shield-lock"></i> Bitácora de auditoría
            </a>
        }
    </div>
</nav>
